{
  "name": "mapa-pozwolen-na-budowe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "oxlint",
    "preview": "vite preview",
    "init-python": "python3.14 -m venv ./script/.venv && source ./script/.venv/bin/activate && python -m pip install --upgrade pip && pip install -r ./script/requirements.txt",
    "generate-data": "npm run init-python && python script/process_parcels.py",
    "build": "npm run generate-data && tsc -b && vite build"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
